# URL pública del sitio (canonical, OG, sitemap, robots)
# Fallback: https://eventos-costa-rica.vercel.app
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Créditos por evento (slug con guiones → guiones bajos en MAYÚSCULAS)
# Ejemplo para content/events/grok-bot-101.json
# IMPORTANTE: Nunca subir valores reales a git. Solo placeholders acá.
# Los valores reales van en Vercel > Settings > Environment Variables.

CREDITS_GROK_BOT_101_CODE=change-me
CREDITS_GROK_BOT_101_LINK_EXISTING=https://example.com/change-me-existing
CREDITS_GROK_BOT_101_LINK_NEW=https://example.com/change-me-new

# Rate limiting persistente con Upstash (opcional)
# Si no están, se usa un rate limiter en memoria (no persistente entre instancias)
# Opción A: Upstash Redis
UPSTASH_REDIS_REST_URL=https://tu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token

# Opción B: Vercel KV (alternativa si usás la integración de Vercel)
# KV_REST_API_URL=https://tu-kv.vercel-storage.com
# KV_REST_API_TOKEN=tu-token
